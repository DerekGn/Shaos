@page
@model Shaos.Pages.Parameters.HistoryModel

<h1>Parameter History</h1>

<hr />

<form asp-page-handler="apply" method="post" asp-route-id="@Model.Id" asp-route-deviceId="@Model.DeviceId">
<div class="row">
    <div class="col-sm-1">
        StartTime:
    </div>
    <div class="col-sm-3">
        <input asp-for="@Model.StartDateTime" type="datetime-local" class="form-control" />
    </div>
    <div class="col-sm-1">
        EndTime:
    </div>
    <div class="col-sm-3">
        <input asp-for="@Model.EndDateTime" type="datetime-local" class="form-control" />
    </div>
    <div class="col-sm-3">
        <button class="btn btn-sm btn-primary">Apply</button>
    </div>
</div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</form>

<div class="container-fluid">
    <div id="container"></div>
</div>

<a asp-page="/Parameters/Index" asp-route-id="@Model.DeviceId" class="btn btn-sm btn-primary">Back</a>

<script id="history" type="application/json">@Json.Serialize(Model.History)</script>
<script id="settings" type="application/json">@Json.Serialize(Model.Settings)</script>

<script src="~/lib/dygraphs/dist/dygraph.min.js"></script>
<script src="~/js/common.js"></script>
<script src="~/js/history.js"></script>

<link rel="stylesheet" type="text/css" src="~/dygraphs/dist/dygraph.css" />
