# Update configuration to match application configuration
# Use the Autorisation.http script to generate an access token
@accesstoken = "SET THIS TO BEARER TOKEN"
@address = https://localhost:7000
@pluginid = 1
@codefileid = 1
@pluginidinstanceid = 1
@version = 1

###

# Create a PlugIn
POST {{address}}/api/v{{version}}/plugins
Authorization: Bearer {{accesstoken}}
Accept: application/json
Content-Type: application/json

{
  "name": "Test Plugin",
  "description": "A simple test plugIn"
}

###

# Get all PlugIns
GET {{address}}/api/v{{version}}/plugins
Authorization: Bearer {{accesstoken}}
Accept: application/json

###

# Create a plugin instance
POST {{address}}/api/v{{version}}/plugins/{{pluginid}}/instances
Authorization: Bearer {{accesstoken}}
Accept: application/json
Content-Type: application/json

{
  "name" : "Test Instance",
  "description" : "A test plugin instance"
}

###

# Delete A plugin
DELETE {{address}}/api/v{{version}}/plugins/{{pluginid}}
Authorization: Bearer {{accesstoken}}
Accept: application/json

###

# Get PlugIn by Id
GET {{address}}/api/v{{version}}/plugins/{{pluginid}}
Authorization: Bearer {{accesstoken}}
Accept: application/json

###

# Update a PlugIn by Id
PUT {{address}}/api/v{{version}}/plugins/{{pluginid}}
Authorization: Bearer {{accesstoken}}
Accept: application/json
Content-Type: application/json

{
  "name": "Test Plugin",
  "description": "A simple test plugIn updated"
}

###

# Delete the instances
DELETE {{address}}/api/v{{version}}/plugins/instances/{{pluginidinstanceid}}
Authorization: Bearer {{accesstoken}}
Accept: application/json

###

# Update a plugin instance
PUT {{address}}/api/v{{version}}/plugins/instances/{{pluginidinstanceid}}
Authorization: Bearer {{accesstoken}}
Accept: application/json
Content-Type: application/json

{
  "name": "string",
  "description": "Updated Description"
}

###

# Enable a plugin instance
PUT {{address}}/api/v{{version}}/plugins/instances/{{pluginid}}/enable/true
Authorization: Bearer {{accesstoken}}
Accept: application/json

###

# Disable a plugin instance
PUT {{address}}/api/v{{version}}/plugins/instances/{{pluginid}}/enable/false
Authorization: Bearer {{accesstoken}}
Accept: application/json

###